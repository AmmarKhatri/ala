{
  "name": "ala-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Any Language Assembler: verified native-code optimization for AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm test",
    "check:architecture": "node scripts/checkArchitecture.mjs",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "bin": {
    "ala": "bin/ala.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ]
}
